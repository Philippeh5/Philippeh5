      "evidence": "policy (2026-09-25_v2 Codex-RESERVE rebalance) — same AGY-first order as standard-coding, now also naming Claude-in-AGY and making Codex the explicit final reserve instead of dropping the job into a park state",
      "default": [
        { "provider": "agy", "model": "gemini-3.7-flash-high", "sandbox": "workspace-write" }
      ],
      "fallbacks": [
        { "provider": "agy", "model": "gemini-3.1-pro-high", "sandbox": "workspace-write" },
        { "provider": "agy", "model": "claude-sonnet-4-6", "sandbox": "workspace-write" },
        { "provider": "gateway-openrouter", "model": "sonnet", "effort": "n/a" },
