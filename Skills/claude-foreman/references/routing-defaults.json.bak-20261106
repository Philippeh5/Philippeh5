      ],
      "fallbacks": [
        { "provider": "grok", "model": "grok-4.6", "effort": "medium", "sandbox": "read-only" },
        { "provider": "gateway-openrouter", "model": "sonnet", "effort": "n/a", "sandbox": "read-only" },
        { "provider": "gateway-openrouter", "model": "opus", "effort": "n/a", "sandbox": "read-only", "note": "intra-provider fallback — live-tested 2026-09-25" },
        { "provider": "agy", "model": "gemini-3.1-pro-high", "effort": "n/a", "sandbox": "read-only" }
      ],
      "why": "a same-family verifier shares the builder's blind spots; Codex read-only is the strongest cross-family second opinion when present, Grok the cheap adversarial read, the gateway seat the cheapest off-family read when Codex is absent, agy the last resort — confirm every citation before acting on any of them."
    },
